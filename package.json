{
  "name": "arg-study-bot",
  "version": "1.0.0",
  "description": "Production-grade Telegram educational platform bot for AGR Study using grammY and Turso.",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "db:init": "tsx scripts/init-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "turso",
    "libsql",
    "education",
    "study"
  ],
  "author": "Ahmed Reda",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.11.3",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
